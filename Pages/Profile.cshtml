@page
@model ProfileModel
@{
    ViewData["Title"] = "Личный кабинет";
}

<h1>Личный кабинет</h1>
@if (Model.Ordered)
{
    <div class="alert ok">Заказ оформлен! Спасибо.</div>
}

<div class="grid">
    <form method="post" class="card">
        <h3>Профиль</h3>
        <p class="muted">@Model.Email</p>
        <div class="form-group">
            <label>ФИО</label>
            <input asp-for="FullName" class="form-control">
            <span asp-validation-for="FullName" class="err"></span>
        </div>
        <div class="form-group">
            <label>Телефон</label>
            <input asp-for="Phone" class="form-control">
        </div>
        <button class="btn">Сохранить</button>
    </form>
</div>

<h2>Мои заказы</h2>
<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th>№</th>
                <th>Дата</th>
                <th>Сумма</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model.Orders)
            {
                <tr>
                    <td>@o.Id</td>
                    <td>@o.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@o.TotalSum.ToString("0.##") ₽</td>
                    <td>@o.Status</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts
{
    @if (Model.Ordered)
    {
        <script>localStorage.removeItem('cart'); updateCount();</script>
    }
}