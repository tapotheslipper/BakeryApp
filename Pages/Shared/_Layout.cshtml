<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Пекарня у дома</title>
    <script type="importmap"></script>
    <link rel="icon" href="~/images/logo.svg">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="container">
            <a class="brand" asp-page="/Index">
                <img src="~/images/logo.svg" alt="" width="32" height="32"> Пекарня у дома
            </a>
            <button class="burger-btn" onclick="toggleMenu()">☰</button>
            <nav id="navMenu">
                <a asp-page="/About">О пекарне</a>
                <a asp-page="/Catalog">Каталог</a>
                <a asp-page="/Promotions">Акции</a>
                <a asp-page="/News">Новости</a>
                <a asp-page="/Reviews">Отзывы</a>
                <a asp-page="/Contacts">Контакты</a>
                <a asp-page="/Cart" class="cart-link">Корзина <span id="cartCount" class="badge">0</span></a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("admin") || User.IsInRole("manager"))
                    {
                        <a asp-page="/Admin/Index">Админ-панель</a>
                    }
                    <a asp-page="/Profile" class="profile-link">@User.Identity.Name</a>
                    <form method="post" asp-page="/Logout" class="inline">
                        <button class="link-btn">Выйти</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Login" class="profile-link">Войти</a>
                }
            </nav>
        </div>
    </header>

    <div class="container">
        <main role="main">@RenderBody()</main>
    </div>

    <footer>
        <div class="container">
            <div>&copy; 2026 - "Пекарня у дома" | Вариант 14</div>
            <div class="links">
                <a asp-page="/Team">Разработчик/и</a>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
