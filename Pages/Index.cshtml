@page
@model IndexModel
@{ ViewData["Title"] = "Главная"; }

<div class="slider">
    <div class="slide active s1">
        <h2>Свежая выпечка каждое утро</h2>
        <p>Горячие круассаны с 07:00</p>
    </div>
    <div class="slide s2">
        <h2>Акция: хлеб вечером -30%</h2>
        <p>После 19:00 каждый день</p>
    </div>
    <div class="slide s3">
        <h2>Осеннее меню</h2>
        <p>Пироги</p>
    </div>
    <button class="slider-btn prev">&lt;</button>
    <button class="slider-btn next">&gt;</button>
</div>

<section class="section">
    <h2>О пекарне</h2>
    <p>Мы печём хлеб и сладости с 2042-го года: всё на пасеке со свинопасами. <a asp-page="/About">Подробнее</a></p>
</section>

<section class="section">
    <h2>Рекоммендуем</h2>
    <div class="grid">
        @foreach (var p in Model.Featured) { <partial name="_ProductCard" model="p" /> }
    </div>
</section>

<section class="section">
    <h2>Акции</h2>
    <div class="grid">
        @foreach (var a in Model.Promos)
        {
            <div class="card">
                <h5>@a.Title <span class="badge">@a.Discount</span></h5>
                <p>@a.Text</p>
            </div>
        }
    </div>
</section>

<section class="section">
    <h2>Новости</h2>
    <div class="grid">
        @foreach (var n in Model.LatestNews)
        {
            <div class="card">
                <h5>@n.Title</h5>
                <p>@n.Text</p>
                <small class="muted">@n.CreatedAt.ToString("dd.MM.yyyy")</small>
            </div>
        }
    </div>
</section>

<section>
    <h2>Отзывы</h2>
    <div class="grid">
        @foreach (var r in Model.Reviews)
        {
            <div class="card">
                <h5>@r.UserName <span class="stars">@(new string('★', r.Rating))</span></h5>
                <p>@r.Text</p>
            </div>
        }
    </div>
    <a asp-page="/Reviews">Все отзывы</a>
</section>

<section class="section">
    <h2>Контакты</h2>
    <p>г. Чебаркули, ул. Хлебобулочная, 1 | +7 (900) 800-70-60 | ежедневно 07:00-21:00</p>
    <iframe class="map" src="https://yandex.ru/map-widget/v1/?ll=37.6173%2C55.7558&z=12" loading="lazy"></iframe>
</section>